{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"composite": true,
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"lib": ["ES2022"],
		"types": ["node"],
		"rootDir": ".",
		"outDir": "./dist",
		"noEmit": false,
		"allowImportingTsExtensions": false
	},
	"references": [{ "path": "../shared" }],
	"include": ["./**/*.ts"],
	"exclude": ["node_modules", "dist"]
}
