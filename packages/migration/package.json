{
	"name": "@rita-berenice/migration",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"description": "Public demo seed scripts (development only)",
	"scripts": {
		"demo:seed": "tsx --env-file ../../.env demo/seedPublicDemo.ts",
		"demo:test": "tsc --project tsconfig.demo.json && tsx --test demo/demoFixture.test.ts",
