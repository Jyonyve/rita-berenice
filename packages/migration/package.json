		"embedding:typecheck": "tsc --project tsconfig.embedding.json"
	},
	"dependencies": {
		"@rita-berenice/server": "workspace:*",
		"@rita-berenice/shared": "workspace:*"
	},
	"devDependencies": {
		"tsx": "4.20.6"
	}
}
