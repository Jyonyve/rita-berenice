{
	"name": "@rita-berenice/migration",
	"version": "1.6.0",
	"private": true,
	"type": "module",
	"description": "Database migration and management scripts (development only)",
	"scripts": {
		"build": "echo 'Migration package does not need building - skipping'",
		"clean": "rimraf dist",
		"dev": "tsx watch ./index.ts",
		"proxy:chromadb": "fly proxy 8000:8000 -a chromadb-flyio",
		"init:char": "tsx --env-file ../../.env character/initCharacter.ts",
		"check:char": "tsx --env-file ../../.env character/checkCharacter.ts",
		"crawl": "tsx chat/crawlChat.ts",
		"valid:chat": "tsx chat/validateChat.ts",
		"init:chat": "tsx --env-file ../../.env chat/initChat.ts",
		"import:chat": "tsx --env-file ../../.env chat/importNewChat.ts",
		"check:chat": "tsx --env-file ../../.env chat/checkChat.ts",
		"delete:chat": "tsx --env-file ../../.env chat/deleteChat.ts",
		"purge:chat": "tsx --env-file ../../.env chat/pergeChat.ts",
		"clean:chat": "tsx --env-file ../../.env chat/cleanUpNewTurns.ts",
		"dupe:chat": "tsx --env-file ../../.env chat/duplicateChat.ts",
		"delete:mess": "tsx --env-file ../../.env chat/removeMessage.ts",
		"patch:emotion": "tsx --env-file ../../.env chat/patchEmotion.ts",
		"check:temp": "tsx --env-file ../../.env chat/checkTempChat.ts",
		"init:prof": "tsx --env-file ../../.env profile/initProfile.ts",
		"check:prof": "tsx --env-file ../../.env profile/checkProfile.ts",
		"init:sess": "tsx --env-file ../../.env session/initSession.ts",
		"init:term": "tsx --env-file ../../.env term/initTerm.ts",
		"init:cred": "tsx --env-file ../../.env credential/initializeApiKeys.ts",
		"recap:factual": "tsx --env-file ../../.env recap/recapChat.ts",
		"recap:modify": "tsx --env-file ../../.env recap/modifyRecap.ts",
		"recap:relationship": "tsx --env-file ../../.env recap/recapRelationship.ts",
		"export:recap": "tsx recap/exportSingleRecap.ts",
		"init:his": "tsx --env-file ../../.env lore/initHistory.ts",
		"dupe:his": "tsx --env-file ../../.env lore/duplicateHistory.ts",
		"check:his": "tsx --env-file ../../.env lore/checkHistory.ts",
		"link:chat": "tsx lore/linkChatToHistory.ts",
		"extract:lore": "tsx --env-file ../../.env source/htmlParserCheerio.ts",
		"init:user": "tsx --env-file ../../.env user/initUser.ts",
		"drop": "tsx --env-file ../../.env dropCollection.ts",
		"check": "tsx --env-file ../../.env checkCollection.ts",
		"delete": "tsx --env-file ../../.env ../scripts/deleteUser.ts",
		"verify": "tsx --env-file ../../.env ../scripts/verifyUser.ts",
		"temp": "tsx --env-file ../../.env ../scripts/migUser.ts",
		"mig": "tsx --env-file ../../.env migDB.ts",
		"generate-keys": "tsx credential/crypto-keys.ts"
	},
	"dependencies": {
		"@rita-berenice/shared": "workspace:*",
		"@rita-berenice/server": "workspace:*",
		"@chroma-core/cohere": "^0.1.7",
		"@chroma-core/openai": "^0.1.7",
		"@langchain/anthropic": "^0.3.26",
		"@langchain/core": "^0.3.72",
		"@langchain/deepseek": "^0.1.0",
		"@langchain/google-genai": "^0.2.16",
		"@langchain/groq": "^0.2.3",
		"@langchain/openai": "^0.6.9",
		"axios": "^1.11.0",
		"chromadb": "^3.0.14",
		"form-data": "^4.0.4",
		"franc": "^6.2.0",
		"openai": "^5.16.0",
		"puppeteer": "^24.19.0",
		"cheerio": "^1.1.2",
		"sharp": "^0.34.3",
		"supertokens-node": "^23.0.1",
		"tiktoken": "^1.0.22",
		"zod": "^4.1.11"
	},
	"devDependencies": {
		"rimraf": "^6.0.1",
		"tsc-alias": "^1.8.16",
		"tsx": "^4.20.5"
	}
}
