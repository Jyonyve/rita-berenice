{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2020"],
    "types": ["node"],
    "rootDir": ".",
    "outDir": "../../dist/server",
    "noEmit": false,
    "allowImportingTsExtensions": false
  },
  "references": [
    { "path": "../shared" }
  ],
  "include": ["./**/*.ts", "./**/*.tsx"],
  "exclude": ["node_modules", "dist"]
}
