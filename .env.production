# ================================
# Variables for Client (VITE_ prefix)
# ================================
VITE_API_URL=""
VITE_APP_ENV="production" # Or "development" in .env.development


# ================================
# Variables for Server (NO VITE_ prefix)
# ================================

# --- Langchain ---
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=""
LANGCHAIN_API_KEY=""
LANGCHAIN_PROJECT=""

# --- ChromaDB ---
CHROMA_API_URL="" # Renamed from VITE_CHROMA_API_URL

# --- API Keys (Secrets!) ---
OPENAI_API_KEY=""
GROQ_API_KEY=""
OPENROUTER_API_KEY=""

# --- AWS Bedrock ---
BEDROCK_AWS_REGION=""
BEDROCK_AWS_ACCESS_KEY_ID=""
BEDROCK_AWS_SECRET_ACCESS_KEY=""
BEDROCK_AWS_PROFILE="admin-jyonyve"
AWS_REPO_URL="" # Assuming server-side

# --- Local AI / Dev ---
LOCAL_AI_URL="http://localhost:11434/api/chat" # Renamed from VITE_LOCAL_URL

# --- SSR Server Config ---
SSR_PORT=3000
SSR_HOST="0.0.0.0"

# --- Build Config (Optional - might not need in .env) ---
# SSR_ENTRY="/src/entry-server.tsx" # Likely not needed at runtime
# CLIENT_ENTRY="/src/entry-client.tsx" # Likely not needed at runtime
