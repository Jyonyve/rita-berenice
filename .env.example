# Runtime
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
BASE=/

# Optional development-only retrieval trace. Query text can be sensitive.
RITA_RAG_TRACE=false

# Public web/client domains
VITE_APP_ENV=development
VITE_APP_DOMAIN=http://localhost:3000
VITE_API_DOMAIN=http://localhost:3000

# SuperTokens
SUPERTOKENS_CONNECTION_URI=http://localhost:3567
SUPERTOKENS_API_KEY=
# Stable label for the SuperTokens user directory, not its connection URL.
AUTH_IDENTITY_NAMESPACE=supertokens-dev
# Create the linked Rita user and identity mapping automatically on SuperTokens signup.
# On by default; without it a signup succeeds in SuperTokens but has no Rita user, and
# session creation then fails with a 403. Set to false only for manual administrative
# provisioning, where every identity mapping is created by hand up front.
AUTO_PROVISION_USERS=true
DASHBOARD_ADMIN_EMAILS=

# PostgreSQL + pgvector
DATABASE_URL=postgresql://rita:rita@localhost:5432/rita_berenice
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# Runtime uploaded image files. Local storage is the development/test fallback.
LOCAL_IMAGE_STORAGE_DIR=public/assets
# Optional S3-compatible private object storage (Fly Tigris in production).
# Configure all four values together. AWS_REGION defaults to auto.
BUCKET_NAME=
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=auto

# Embedding provider
OPENAI_API_KEY=
# Keep this on small until a staged model migration is fully cut over.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# User API key encryption at rest
SECRET_ENCRYPTION_KEY=

# Optional LLM providers
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
