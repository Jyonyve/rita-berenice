# Runtime
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
BASE=/

# Public web/client domains
VITE_APP_ENV=development
VITE_APP_DOMAIN=http://localhost:3000
VITE_API_DOMAIN=http://localhost:3000
VITE_SUPERTOKENS_DOMAIN=

# SuperTokens
SUPERTOKENS_DOMAIN=
SUPERTOKENS_API_KEY=
DASHBOARD_ADMIN_EMAILS=

# ChromaDB
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_SSL=false

# Embedding providers used by the server Chroma client
OPENAI_API_KEY=
COHERE_API_KEY=

# User API key encryption at rest
SECRET_ENCRYPTION_KEY=

# Asymmetric login private JWK, JSON encoded
PRIVATE_KEY=

# Optional LLM providers used by migration scripts
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
