{
	"compilerOptions": {
		"strict": true,
		"module": "ES2020",
		"moduleResolution": "nodenext",
		"target": "ES2020",
		"lib": ["DOM", "DOM.Iterable", "ESNext"],
		"jsx": "react-jsx",
		"skipLibCheck": true,
		"esModuleInterop": true,

		/* Path aliases */
		"baseUrl": "",
		"paths": {
			"#root/*": ["./*"],
			"@/*": ["./src/*"],
			"@server/api": ["src/server/api/*"],
			"@client/domain/*": ["src/client/domain/*"],
			"@client/component/*": ["src/client/component/*"],
			"@client/hook/*": ["src/client/hook/*"],
			"@client/asset/*": ["src/client/assets/*"],
			"@shared/*": ["./src/shared/*"]
		}
	},
	"files": [],
	"references": [{ "path": "./tsconfig.app.json" }, { "path": "./tsconfig.node.json" }]
}
