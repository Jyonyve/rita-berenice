{
	"compilerOptions": {
		"target": "ES2020",
		"lib": ["DOM", "DOM.Iterable", "ESNext"],
		"module": "NodeNext",
		"moduleResolution": "nodenext",
		"jsx": "react-jsx",
		"strict": true,
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"skipLibCheck": true,
		"useDefineForClassFields": true,
		"baseUrl": ".",
		"paths": {
			"#client/*": ["src/client/*"],
			"@rita-berenice/shared/*": ["src/shared/*"],
			"#server/*": ["src/server/*"]
		},
		"types": ["vite/client"]
	},
	"include": ["src/**/*", "vite.config.ts", "src/**/*.d.ts", "packages/types.d.ts", "packages/entry-client.tsx", "packages/entry-server.tsx", "packages/vite-env.d.ts"],
	"exclude": ["node_modules", "dist", ".vite_cache"]
}
