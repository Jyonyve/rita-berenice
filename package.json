{
	"name": "rita-berenice",
	"version": "1.7.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.17.1",
	"scripts": {
		"dev": "pnpm --parallel --filter @rita-berenice/client --filter @rita-berenice/server dev",
		"build": "pnpm --filter @rita-berenice/shared build && pnpm --parallel --filter @rita-berenice/client --filter @rita-berenice/server build",
		"build:shared": "pnpm --filter @rita-berenice/shared build",
		"build:client": "pnpm --filter @rita-berenice/client build",
		"build:server": "pnpm --filter @rita-berenice/server build",
		"clean": "rimraf packages/*/dist && rimraf dist && rimraf node_modules",
		"start": "node dist/server/server.js"
	},
	"devDependencies": {
		"@types/node": "^24.3.0",
		"typescript": "^5.9.2",
		"prettier": "^3.6.2",
		"rimraf": "^6.0.1",
		"tsx": "^4.20.5"
	},
	"pnpm": {
		"overrides": {
			"rollup": "npm:@rollup/wasm-node"
		}
	}
}
