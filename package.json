{
	"name": "rita-berenice-migration",
	"version": "1.6.0",
	"type": "module",
	"scripts": {
		"clean": "rimraf dist && rimraf node_modules",
		"build": "pnpm run build:server",
		"build:server": "tsc --project tsconfig.server.json && tsc-alias -p tsconfig.server.json",
		"proxy:chromadb": "fly proxy 8000:8000 -a chromadb-flyio",
		"init:char": "tsx --env-file .env ./src/migration/character/initCharacter.ts",
		"check:char": "tsx --env-file .env ./src/migration/character/checkCharacter.ts",
		"crawl": "tsx ./src/migration/chat/crawlChat.ts",
		"valid:chat": "tsx ./src/migration/chat/validateChat.ts",
		"init:chat": "tsx --env-file .env ./src/migration/chat/initChat.ts",
		"check:chat": "tsx --env-file .env ./src/migration/chat/checkChat.ts",
		"delete:chat": "tsx --env-file .env ./src/migration/chat/deleteChat.ts",
		"patch:chat": "tsx --env-file .env ./src/migration/chat/patchChat.ts",
		"purge:chat": "tsx --env-file .env ./src/migration/chat/pergeChat.ts",
		"clean:chat": "tsx --env-file .env ./src/migration/chat/cleanUpNewTurns.ts",
		"dupe:chat": "tsx --env-file .env ./src/migration/chat/duplicateChat.ts",
		"delete:mess": "tsx --env-file .env ./src/migration/chat/removeMessage.ts",
		"patch:emotion": "tsx --env-file .env ./src/migration/chat/patchEmotion.ts",
		"check:temp": "tsx --env-file .env ./src/migration/chat/checkTempChat.ts",
		"init:prof": "tsx --env-file .env ./src/migration/profile/initProfile.ts",
		"check:prof": "tsx --env-file .env ./src/migration/profile/checkProfile.ts",
		"init:sess": "tsx --env-file .env ./src/migration/session/initSession.ts",
		"init:term": "tsx --env-file .env ./src/migration/term/initTerm.ts",
		"init:cred": "tsx --env-file .env ./src/migration/credential/initializeApiKeys.ts",
		"recap:factual": "tsx --env-file .env ./src/migration/recap/recapChat.ts",
		"recap:modify": "tsx --env-file .env ./src/migration/recap/modifyRecap.ts",
		"recap:relationship": "tsx --env-file .env ./src/migration/recap/recapRelationship.ts",
		"export:recap": "tsx ./src/migration/recap/exportSingleRecap.ts",
		"init:his": "tsx --env-file .env ./src/migration/lore/initHistory.ts",
		"dupe:his": "tsx --env-file .env ./src/migration/lore/duplicateHistory.ts",
		"check:his": "tsx --env-file .env ./src/migration/lore/checkHistory.ts",
		"link:chat": "tsx ./src/migration/lore/linkChatToHistory.ts",
		"extract:lore": "tsx --env-file .env ./src/migration/source/htmlParserCheerio.ts",
		"drop": "tsx --env-file .env ./src/migration/dropCollection.ts",
		"collection": "tsx --env-file .env ./src/migration/checkCollection.ts",
		"delete": "tsx --env-file .env ./scripts/deleteUser.ts",
		"verify": "tsx --env-file .env ./scripts/verifyUser.ts",
		"temp": "tsx --env-file .env ./scripts/migUser.ts",
		"mig": "tsx --env-file .env ./src/migration/migDB.ts"
	},
	"dependencies": {
		"@langchain/anthropic": "^0.3.25",
		"@langchain/core": "^0.3.66",
		"@langchain/deepseek": "^0.1.0",
		"@langchain/google-genai": "^0.2.16",
		"@langchain/groq": "^0.2.3",
		"@langchain/openai": "^0.6.3",
		"@chroma-core/openai": "^0.1.7",
		"cheerio": "^1.1.2",
		"chromadb": "^3.0.10",
		"date-fns": "^4.1.0",
		"form-data": "^4.0.4",
		"franc": "^6.2.0",
		"fuzzball": "^2.2.2",
		"nanoid": "^5.1.5",
		"onnxruntime-node": "^1.21.0",
		"openai": "^5.10.2",
		"puppeteer": "^24.15.0",
		"sharp": "^0.34.3",
		"tiktoken": "^1.0.21",
		"zod": "^4.0.12"
	},
	"devDependencies": {
		"@types/node": "^24.1.0",
		"rimraf": "^6.0.1",
		"tsc-alias": "^1.8.16",
		"tsx": "^4.20.3",
		"typescript": "^5.8.3"
	},
	"imports": {
		"#server/": "./src/server/",
		"#shared/": "./src/shared/"
	},
	"packageManager": "pnpm@10.14.0+sha512.ad27a79641b49c3e481a16a805baa71817a04bbe06a38d17e60e2eaee83f6a146c6a688125f5792e48dd5ba30e7da52a5cda4c3992b9ccf333f9ce223af84748"
}
