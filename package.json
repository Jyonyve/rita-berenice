{
	"name": "rita-berenice",
	"homepage": "https://jyonyve.github.io/rita-berenice",
	"version": "1.6.0",
	"type": "module",
	"scripts": {
		"clean": "rimraf dist && rimraf node_modules",
		"dev": "tsx --env-file .env.development ./src/server/server.ts",
		"build:client": "vite build --outDir dist/client",
		"build:server": "vite build --ssr src/entry-server.tsx --outDir dist/server && tsc --project tsconfig.server.json && tsc-alias -p tsconfig.server.json",
		"build:static": "vite build --mode static --outDir dist/static",
		"build": "pnpm run build:client && pnpm run build:server",
		"proxy": "fly proxy 8000:8000 -a chromadb-flyio",
		"start": "node dist/server/server.js",
		"preview": "cross-env NODE_ENV=development node --env-file .env.development dist/server/server.js",
		"preview:static": "vite preview --mode static --outDir dist/static",
		"prod": "pnpm run build && pnpm run start"
	},
	"dependencies": {
		"@chroma-core/openai": "^0.1.7",
		"@emotion/cache": "^11.14.0",
		"@emotion/react": "^11.14.0",
		"@emotion/server": "^11.11.0",
		"@emotion/styled": "^11.14.0",
		"@langchain/anthropic": "^0.3.25",
		"@langchain/core": "^0.3.66",
		"@langchain/deepseek": "^0.1.0",
		"@langchain/google-genai": "^0.2.16",
		"@langchain/groq": "^0.2.3",
		"@langchain/openai": "^0.6.3",
		"@mui/icons-material": "^7.2.0",
		"@mui/material": "^7.2.0",
		"@mui/system": "^7.2.0",
		"@tanstack/react-query": "^5.83.0",
		"axios": "^1.11.0",
		"chromadb": "^3.0.10",
		"compression": "^1.8.1",
		"cors": "^2.8.5",
		"date-fns": "^4.1.0",
		"express": "^5.1.0",
		"franc": "^6.2.0",
		"idb": "^8.0.3",
		"nanoid": "^5.1.5",
		"openai": "^5.10.2",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"react-hook-form": "^7.61.1",
		"react-infinite-scroll-component": "^6.1.0",
		"react-router": "^7.7.1",
		"react-virtuoso": "^4.13.0",
		"sirv": "^3.0.1",
		"supertokens-auth-react": "^0.49.1",
		"supertokens-node": "^23.0.0",
		"supertokens-web-js": "^0.15.0",
		"swiper": "^11.2.10",
		"tiktoken": "^1.0.21",
		"vite": "^6.2.5",
		"vite-tsconfig-paths": "^5.1.4",
		"zlib": "^1.0.5",
		"zod": "^4.0.12"
	},
	"devDependencies": {
		"@emotion/babel-plugin": "^11.13.5",
		"@eslint/js": "^9.32.0",
		"@swc/core": "^1.13.0",
		"@types/compression": "^1.8.1",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.3",
		"@types/node": "^24.1.0",
		"@types/react": "^19.1.7",
		"@types/react-dom": "^19.1.7",
		"@typescript-eslint/eslint-plugin": "^8.38.0",
		"@typescript-eslint/parser": "^8.38.0",
		"@vitejs/plugin-react": "^4.7.0",
		"cross-env": "^10.0.0",
		"eslint": "^9.32.0",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^5.2.0",
		"prettier": "^3.6.2",
		"rimraf": "^6.0.1",
		"sass": "^1.89.2",
		"tsc-alias": "^1.8.16",
		"tsx": "^4.20.3",
		"typescript": "^5.8.3",
		"vite-plugin-node-polyfills": "^0.24.0",
		"vite-plugin-svgr": "^4.3.0"
	},
	"peerDependencies": {
		"react": "^17.0.0 || ^18.0.0 || ^19.0.0",
		"react-dom": "^17.0.0 || ^18.0.0 || ^19.0.0"
	},
	"pnpm": {
		"overrides": {
			"rollup": "npm:@rollup/wasm-node"
		}
	},
	"imports": {
		"#server/": "./src/server/",
		"#client/": "./src/client/",
		"#shared/": "./src/shared/"
	},
	"packageManager": "pnpm@10.14.0+sha512.ad27a79641b49c3e481a16a805baa71817a04bbe06a38d17e60e2eaee83f6a146c6a688125f5792e48dd5ba30e7da52a5cda4c3992b9ccf333f9ce223af84748"
}
