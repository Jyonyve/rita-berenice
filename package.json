{
	"name": "rita-berenice",
	"version": "1.8.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.18.0",
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"build:shared": "pnpm --filter @rita-berenice/shared build",
		"build:client": "pnpm --filter @rita-berenice/client build",
		"build:server": "pnpm --filter @rita-berenice/server build",
		"clean": "turbo run clean && rimraf dist node_modules",
		"clean:dist": "turbo run clean && rimraf dist",
		"start": "node dist/server/server.js",
		"migration": "pnpm --filter @rita-berenice/migration-tool",
		"migration:install": "pnpm --filter @rita-berenice/migration-tool install",
		"update:check": "pnpm outdated -r",
		"update:all": "pnpm update -r --latest"
	},
	"devDependencies": {
		"@types/node": "^24.6.2",
		"@vitejs/plugin-react": "^5.0.4",
		"prettier": "^3.6.2",
		"rimraf": "^6.0.1",
		"tsx": "^4.20.6",
		"turbo": "^2.5.8",
		"typescript": "^5.9.3",
		"vite": "^7.1.7",
		"vite-plugin-node-polyfills": "^0.24.0",
		"vite-plugin-svgr": "^4.5.0",
		"vite-tsconfig-paths": "^5.1.4"
	},
	"pnpm": {
		"overrides": {
			"rollup": "npm:@rollup/wasm-node"
		}
	}
}
