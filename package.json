{
	"name": "rita-berenice",
	"private": true,
	"version": "1.2.0",
	"type": "module",
	"scripts": {
		"clean": "rimraf dist && rimraf node_modules",
		"dev": "tsx --env-file .env.development ./src/server/server.ts",
		"build:client": "vite build --outDir dist/client",
		"build:server": "tsc --project tsconfig.server.json && tsc-alias -p tsconfig.server.json",
		"build": "pnpm run build:client && pnpm run build:server",
		"start": "cross-env NODE_ENV=production node --env-file .env.production dist/server/server.js",
		"preview": "cross-env NODE_ENV=development node --env-file .env.development dist/server/server.js",
		"prod": "pnpm run build && pnpm run start",
		"init:char": "tsx ./src/migration/character/initCharacter.ts",
		"check:char": "tsx ./src/migration/character/checkCharacter.ts",
		"crawl:chat": "tsx ./src/migration/chat/crawlChat.ts",
		"init:chat": "tsx ./src/migration/chat/initChat.ts",
		"check:chat": "tsx ./src/migration/chat/checkChat.ts",
		"delete:chat": "tsx ./src/migration/chat/deleteChat.ts",
		"init:recap": "tsx ./src/migration/chat/recapChat.ts",
		"export:recap": "tsx ./src/migration/recap/exportSingleRecap.ts",
		"init:his": "tsx ./src/migration/lore/initHistory.ts",
		"check:his": "tsx ./src/migration/lore/checkHistory.ts",
		"link:chat": "tsx ./src/migration/lore/linkChatToHistory.ts",
		"extract:lore": "tsx ./src/migration/source/htmlParserCheerio.ts",
		"drop": "tsx ./src/migration/dropCollection.ts"
	},
	"dependencies": {
		"@chroma-core/default-embed": "^0.1.8",
		"@chroma-core/openai": "^0.1.7",
		"@emotion/babel-plugin": "^11.13.5",
		"@emotion/cache": "^11.14.0",
		"@emotion/react": "^11.14.0",
		"@emotion/server": "^11.11.0",
		"@emotion/styled": "^11.14.0",
		"@langchain/anthropic": "^0.3.22",
		"@langchain/core": "^0.3.58",
		"@langchain/deepseek": "^0.0.2",
		"@langchain/google-genai": "^0.2.12",
		"@langchain/openai": "^0.5.13",
		"@mui/icons-material": "^7.1.1",
		"@mui/material": "^7.1.1",
		"@mui/system": "^7.1.1",
		"@tanstack/react-query": "^5.81.2",
		"@types/react-window": "^1.8.8",
		"@vitejs/plugin-react": "^4.5.2",
		"axios": "^1.10.0",
		"cheerio": "^1.1.0",
		"chromadb": "^3.0.6",
		"compression": "^1.8.0",
		"cors": "^2.8.5",
		"express": "^5.1.0",
		"form-data": "^4.0.3",
		"franc": "^6.2.0",
		"fuzzball": "^2.2.2",
		"idb": "^8.0.3",
		"nanoid": "^5.1.5",
		"onnxruntime-node": "^1.20.1",
		"openai": "^5.8.2",
		"pnpm": "^10.12.4",
		"puppeteer": "^24.10.1",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"react-infinite-scroll-component": "^6.1.0",
		"react-router": "^7.6.3",
		"react-virtualized-auto-sizer": "^1.0.26",
		"react-window": "^1.8.11",
		"sharp": "^0.34.2",
		"sirv": "^3.0.1",
		"supertokens-auth-react": "^0.49.1",
		"supertokens-node": "^22.1.1",
		"supertokens-web-js": "^0.15.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.29.0",
		"@types/compression": "^1.8.1",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.3",
		"@types/node": "^22.14.0",
		"@types/react": "^19.1.8",
		"@types/react-dom": "^19.1.6",
		"@typescript-eslint/eslint-plugin": "^8.34.0",
		"@typescript-eslint/parser": "^8.34.0",
		"cross-env": "^7.0.3",
		"eslint": "^9.29.0",
		"eslint-plugin-react": "^7.35.0",
		"eslint-plugin-react-hooks": "^5.2.0",
		"prettier": "^3.3.3",
		"rimraf": "^6.0.1",
		"sass": "^1.89.2",
		"tsc-alias": "^1.8.16",
		"tsx": "^4.20.3",
		"typescript": "^5.8.3",
		"vite": "^6.2.5",
		"vite-plugin-node-polyfills": "^0.23.0",
		"vite-plugin-svgr": "^4.2.0",
		"vite-plugin-top-level-await": "^1.4.1",
		"vite-tsconfig-paths": "^5.1.4"
	},
	"peerDependencies": {
		"@browserbasehq/stagehand": "^1.0.0",
		"@ibm-cloud/watsonx-ai": "*",
		"ibm-cloud-sdk-core": "*",
		"react": "^17.0.0 || ^18.0.0 || ^19.0.0",
		"react-dom": "^17.0.0 || ^18.0.0 || ^19.0.0"
	},
	"imports": {
		"#server/": "./src/server/",
		"#client/": "./src/client/",
		"#shared/": "./src/shared/"
	}
}
