{
	"name": "rita-berenice",
	"version": "1.8.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.18.0",
	"scripts": {
		"dev": "pnpm --filter @rita-berenice/server dev",
		"dev:client": "pnpm --filter @rita-berenice/client dev",
		"build": "turbo run build",
		"build:static": "pnpm --filter @rita-berenice/client build:static",
		"typecheck": "pnpm typecheck:shared && pnpm typecheck:server && pnpm typecheck:client",
		"typecheck:shared": "tsc --project packages/shared/tsconfig.json --noEmit",
		"typecheck:server": "tsc --project packages/server/tsconfig.json --noEmit",
		"typecheck:client": "tsc --project packages/client/tsconfig.json --noEmit",
		"test": "pnpm test:server",
		"test:server": "pnpm --filter @rita-berenice/server test",
		"eval:rag": "pnpm --filter @rita-berenice/server eval:rag",
		"db:generate": "pnpm --filter @rita-berenice/server db:generate",
		"db:migrate": "pnpm --filter @rita-berenice/server db:migrate",
		"db:studio": "pnpm --filter @rita-berenice/server db:studio",
		"db:up": "docker compose up -d postgres supertokens",
		"db:down": "docker compose down",
		"data:monday:validate": "pnpm --filter @rita-berenice/migration monday:validate",
		"data:monday:import": "pnpm --filter @rita-berenice/migration monday:import",
		"data:monday:recall": "pnpm --filter @rita-berenice/migration monday:recall",
		"data:monday:enrich": "pnpm --filter @rita-berenice/migration monday:enrich",
		"data:monday:chat-smoke": "pnpm --filter @rita-berenice/migration monday:chat-smoke",
		"data:monday:transfer": "pnpm --filter @rita-berenice/migration monday:transfer",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "pnpm format:check",
		"check": "pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
		"build:shared": "pnpm --filter @rita-berenice/shared build",
		"build:client": "pnpm --filter @rita-berenice/client build",
		"build:server": "pnpm --filter @rita-berenice/server build",
		"clean": "turbo run clean && rimraf dist node_modules",
		"clean:dist": "turbo run clean && rimraf dist",
		"start": "node dist/server/server.js",
		"migration": "pnpm --filter @rita-berenice/migration",
		"migration:install": "pnpm --filter @rita-berenice/migration install",
		"update:check": "pnpm outdated -r",
		"update:all": "pnpm update -r --latest"
	},
	"devDependencies": {
		"@types/node": "^24.6.2",
		"@vitejs/plugin-react": "^5.0.4",
		"prettier": "^3.6.2",
		"rimraf": "^6.0.1",
		"tsx": "^4.20.6",
		"turbo": "^2.5.8",
		"typescript": "^5.9.3",
		"vite": "^7.1.7",
		"vite-plugin-node-polyfills": "^0.24.0",
		"vite-plugin-svgr": "^4.5.0",
		"vite-tsconfig-paths": "^5.1.4"
	},
	"pnpm": {
		"overrides": {
			"rollup": "npm:@rollup/wasm-node"
		}
	}
}
