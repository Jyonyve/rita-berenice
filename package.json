{
	"name": "rita-berenice",
	"homepage": "https://jyonyve.github.io/rita-berenice",
	"version": "1.5.0",
	"type": "module",
	"scripts": {
		"clean": "rimraf dist && rimraf node_modules",
		"dev": "tsx --env-file .env.development ./src/server/server.ts",
		"build:client": "vite build --outDir dist/client",
		"build:server": "tsc --project tsconfig.server.json && tsc-alias -p tsconfig.server.json",
		"build:static": "vite build --mode static --outDir dist/static",
		"build": "pnpm run build:client && pnpm run build:server",
		"start": "cross-env NODE_ENV=production node --env-file .env.production dist/server/server.js",
		"preview": "cross-env NODE_ENV=development node --env-file .env.development dist/server/server.js",
		"preview:static": "vite preview --mode static --outDir dist/static",
		"prod": "pnpm run build && pnpm run start",
		"init:char": "tsx --env-file .env ./src/migration/character/initCharacter.ts",
		"check:char": "tsx --env-file .env ./src/migration/character/checkCharacter.ts",
		"crawl": "tsx ./src/migration/chat/crawlChat.ts",
		"valid:chat": "tsx ./src/migration/chat/validateChat.ts",
		"init:chat": "tsx --env-file .env ./src/migration/chat/initChat.ts",
		"check:chat": "tsx --env-file .env ./src/migration/chat/checkChat.ts",
		"delete:chat": "tsx --env-file .env ./src/migration/chat/deleteChat.ts",
		"patch:chat": "tsx --env-file .env ./src/migration/chat/patchChat.ts",
		"clean:chat": "tsx --env-file .env ./src/migration/chat/cleanUpNewTurns.ts",
		"dupe:chat": "tsx --env-file .env ./src/migration/chat/duplicateChat.ts",
		"check:temp": "tsx --env-file .env ./src/migration/chat/checkTempChat.ts",
		"init:prof": "tsx --env-file .env ./src/migration/profile/initProfile.ts",
		"check:prof": "tsx --env-file .env ./src/migration/profile/checkProfile.ts",
		"init:sess": "tsx --env-file .env ./src/migration/session/initSession.ts",
		"init:term": "tsx --env-file .env ./src/migration/term/initTerm.ts",
		"init:cred": "tsx --env-file .env ./src/migration/credential/initializeApiKeys.ts",
		"recap:factual": "tsx --env-file .env ./src/migration/recap/recapChat.ts",
		"recap:modify": "tsx --env-file .env ./src/migration/recap/modifyRecap.ts",
		"recap:relationship": "tsx --env-file .env ./src/migration/recap/recapRelationship.ts",
		"export:recap": "tsx ./src/migration/recap/exportSingleRecap.ts",
		"init:his": "tsx --env-file .env ./src/migration/lore/initHistory.ts",
		"dupe:his": "tsx --env-file .env ./src/migration/lore/duplicateHistory.ts",
		"check:his": "tsx --env-file .env ./src/migration/lore/checkHistory.ts",
		"link:chat": "tsx ./src/migration/lore/linkChatToHistory.ts",
		"extract:lore": "tsx --env-file .env ./src/migration/source/htmlParserCheerio.ts",
		"mock": "tsx ./src/client/mock/mockGenerator.ts",
		"drop": "tsx --env-file .env ./src/migration/dropCollection.ts",
		"temp": "tsx --env-file .env ./scripts/patchResponseEmotionToPrimaryFile.ts"
	},
	"dependencies": {
		"@emotion/cache": "^11.14.0",
		"@emotion/react": "^11.14.0",
		"@emotion/styled": "^11.14.0",
		"@langchain/groq": "^0.2.3",
		"@mui/icons-material": "^7.2.0",
		"@mui/material": "^7.2.0",
		"@mui/system": "^7.2.0",
		"@tanstack/react-query": "^5.83.0",
		"axios": "^1.11.0",
		"idb": "^8.0.3",
		"nanoid": "^5.1.5",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"react-hook-form": "^7.61.1",
		"react-infinite-scroll-component": "^6.1.0",
		"react-router": "^7.7.1",
		"react-virtuoso": "^4.13.0",
		"supertokens-auth-react": "^0.49.1",
		"supertokens-web-js": "^0.15.0",
		"swiper": "^11.2.10",
		"tiktoken": "^1.0.21",
		"zod": "^4.0.12"
	},
	"optionalDependencies": {
		"@chroma-core/default-embed": "^0.1.8",
		"@chroma-core/openai": "^0.1.7",
		"@emotion/server": "^11.11.0",
		"@langchain/anthropic": "^0.3.25",
		"@langchain/core": "^0.3.66",
		"@langchain/deepseek": "^0.1.0",
		"@langchain/google-genai": "^0.2.16",
		"@langchain/openai": "^0.6.3",
		"cheerio": "^1.1.2",
		"chromadb": "^3.0.10",
		"compression": "^1.8.1",
		"cors": "^2.8.5",
		"express": "^5.1.0",
		"form-data": "^4.0.4",
		"franc": "^6.2.0",
		"fuzzball": "^2.2.2",
		"onnxruntime-node": "^1.21.0",
		"openai": "^5.10.2",
		"puppeteer": "^24.15.0",
		"sharp": "^0.34.3",
		"sirv": "^3.0.1",
		"supertokens-node": "^23.0.0"
	},
	"devDependencies": {
		"@emotion/babel-plugin": "^11.13.5",
		"@eslint/js": "^9.32.0",
		"@swc/core": "^1.13.0",
		"@swc/core-linux-x64-gnu": "^1.13.3",
		"@types/compression": "^1.8.1",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.3",
		"@types/node": "^24.1.0",
		"@types/react": "^19.1.7",
		"@types/react-dom": "^19.1.7",
		"@typescript-eslint/eslint-plugin": "^8.38.0",
		"@typescript-eslint/parser": "^8.38.0",
		"@vitejs/plugin-react": "^4.7.0",
		"cross-env": "^10.0.0",
		"eslint": "^9.32.0",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^5.2.0",
		"pnpm": "^10.13.1",
		"prettier": "^3.6.2",
		"rimraf": "^6.0.1",
		"sass": "^1.89.2",
		"tsc-alias": "^1.8.16",
		"tsx": "^4.20.3",
		"typescript": "^5.8.3",
		"vite": "^6.2.5",
		"vite-plugin-node-polyfills": "^0.24.0",
		"vite-plugin-svgr": "^4.3.0",
		"vite-tsconfig-paths": "^5.1.4"
	},
	"peerDependencies": {
		"@browserbasehq/stagehand": "^2.4.1",
		"@ibm-cloud/watsonx-ai": "^1.6.10",
		"ibm-cloud-sdk-core": "^5.4.2",
		"react": "^17.0.0 || ^18.0.0 || ^19.0.0",
		"react-dom": "^17.0.0 || ^18.0.0 || ^19.0.0"
	},
	"pnpm": {
		"overrides": {
			"rollup": "npm:@rollup/wasm-node"
		}
	},
	"imports": {
		"#server/": "./src/server/",
		"#client/": "./src/client/",
		"#shared/": "./src/shared/"
	},
	"packageManager": "pnpm@10.13.1+sha512.37ebf1a5c7a30d5fabe0c5df44ee8da4c965ca0c5af3dbab28c3a1681b70a256218d05c81c9c0dcf767ef6b8551eb5b960042b9ed4300c59242336377e01cfad"
}
