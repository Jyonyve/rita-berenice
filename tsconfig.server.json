{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"rootDir": "src",
		"outDir": "dist/server",
		"noEmit": false,
		"module": "NodeNext",
		"target": "ES2020",
		"moduleResolution": "NodeNext",
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"sourceMap": true,
		"allowImportingTsExtensions": false
	},
	"include": [
		"server.ts",
		"src/server/**/*.ts",
		"src/server/**/*.tsx",
		"src/shared/**/*.ts",
		"src/shared/**/*.tsx",
		"src/shared/**/*.d.ts"
	]
}
