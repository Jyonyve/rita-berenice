{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"rootDir": "src",
		"outDir": "dist",
		"noEmit": false,
		"module": "NodeNext",
		"target": "ES2020",
		"moduleResolution": "NodeNext",
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"sourceMap": true,
		"allowImportingTsExtensions": false
	},
	"paths": {
		"#client/*": ["src/client/*"],
		"@rita-berenice/shared/*": ["src/shared/*"],
		"#server/*": ["src/server/*"]
	},
	"include": [
		"src/server/**/*.ts",
		"src/server/**/*.tsx",
		"src/shared/**/*.ts",
		"src/shared/**/*.tsx",
		"src/shared/**/*.d.ts"
	]
}
